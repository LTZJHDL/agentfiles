+        before = self.db.read_bytes(), self.db.stat().st_mtime_ns
+        self.assertEqual(import_csv(self.csv, self.db, dry_run=True).inserted, 1)
+        self.assertEqual((self.db.read_bytes(), self.db.stat().st_mtime_ns), before)
+        self.assertEqual(self.preview_then_import()["inserted"], 1)
