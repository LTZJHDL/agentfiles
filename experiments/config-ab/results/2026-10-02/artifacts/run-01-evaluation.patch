+    def test_readonly_database_file_can_be_previewed(self):
+        self.db = self.root / "观测 #100%.sqlite"
+        self.baseline()
+        self.write_rows([["north", "one", "2026-01-10", "rain", "99", ""]])
+        before = self.snapshot()
+        original_mode = self.db.stat().st_mode
+        self.db.chmod(0o444)
+        try:
+            result = self.cli("import", str(self.csv), "--json", "--dry-run")
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(json.loads(result.stdout), {
+                "inserted": 0, "updated": 1, "unchanged": 0, "invalid": 0,
+                "errors": [], "dry_run": True,
+            })
+            self.assertEqual(self.snapshot(), before)
+        finally:
+            self.db.chmod(original_mode)
