+
+
+HEADER = ["source", "external_id", "day", "category", "value", "note"]
+SUMMARY_KEYS = {"inserted", "updated", "unchanged", "invalid", "errors"}
+
+
+class PreviewTest(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.root = Path(temporary.name)
+        self.db = self.root / "ledger.sqlite"
+        self.csv = self.root / "input.csv"
+
+    def write_rows(self, rows, header=HEADER):
+        with self.csv.open("w", encoding="utf-8", newline="") as stream:
+            writer = csv.writer(stream)
+            writer.writerow(header)
+            writer.writerows(rows)
+
+    def cli(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "fieldledger", "--db", str(self.db), *args],
+            capture_output=True, text=True, encoding="utf-8",
+            cwd=Path(__file__).resolve().parents[1],
+        )
+
+    def baseline(self):
+        self.write_rows([
+            ["north", "one", "2026-01-10", "rain", "10", "original"],
+            ["north", "one", "2026-02-10", "snow", "20", "current"],
+            ["north", "steady", "2026-01-10", "rain", "3", ""],
+        ])
+        import_csv(self.csv, self.db)
+
+    def snapshot(self):
+        connection = sqlite3.connect(self.db.resolve().as_uri() + "?mode=ro", uri=True)
+        try:
+            schema = connection.execute(
+                "SELECT type, name, tbl_name, sql FROM sqlite_master ORDER BY name"
+            ).fetchall()
+            history = connection.execute("SELECT * FROM revisions ORDER BY revision_id").fetchall()
+            sequence = connection.execute("SELECT * FROM sqlite_sequence ORDER BY name").fetchall()
+        finally:
+            connection.close()
+        return self.db.read_bytes(), self.db.stat().st_mtime_ns, schema, history, sequence
+
+    def preview_then_import(self, exit_code=0):
+        preview = self.cli("import", str(self.csv), "--dry-run", "--json")
+        self.assertEqual(preview.returncode, exit_code, preview.stderr)
+        result = json.loads(preview.stdout)  # Rejects any prose or additional JSON values.
+        self.assertEqual(set(result), SUMMARY_KEYS | {"dry_run"})
+        self.assertIs(result.pop("dry_run"), True)
+        actual = self.cli("import", str(self.csv), "--json")
+        self.assertEqual(actual.returncode, exit_code, actual.stderr)
+        saved = json.loads(actual.stdout)
+        self.assertEqual(set(saved), SUMMARY_KEYS)
+        self.assertEqual(result, saved)
+        return result
+
+    def test_existing_history_preview_matches_import_and_preserves_database(self):
+        self.baseline()
+        self.write_rows([
+            ["north", "one", "2026-02-10", "snow", "20", "current"],
+            ["north", "one", "2026-01-10", "rain", "10", "original"],
+            ["north", "new", "2026-01-10", "rain", "7", ""],
+            ["north", "bad", "2026-02-30", "rain", "1", ""],
+        ])
+        before = self.snapshot()
+        directory = set(self.root.iterdir())
+        preview = import_csv(self.csv, self.db, dry_run=True).as_dict()
+        self.assertEqual(self.snapshot(), before)
+        self.assertEqual(set(self.root.iterdir()), directory)
+        self.assertEqual([preview[k] for k in ("inserted", "updated", "unchanged", "invalid")],
+                         [1, 1, 1, 1])
+        self.assertEqual(self.preview_then_import(exit_code=1), preview)
+
+    def test_repeated_identities_use_file_order_and_ignore_invalid_intermediate_row(self):
+        self.baseline()
+        self.write_rows([
+            ["north", "one", "2026-02-10", "snow", "30", "current"],
+            ["north", "one", "2026-02-10", "snow", "invalid", "current"],
+            ["north", "one", "2026-02-10", "snow", "30", "current"],
