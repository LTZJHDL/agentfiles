+    def test_service_preview_only_uses_readonly_connections_and_never_appends(self):
+        self.baseline()
+        self.write_rows([["north", "one", "2026-01-10", "rain", "99", ""]])
+        before = self.snapshot()
+        real_connect = sqlite3.connect
+
+        def readonly_connect(database, *args, **kwargs):
+            self.assertTrue(kwargs.get("uri"), "preview opened a non-URI connection")
+            self.assertIn("mode=ro", str(database), "preview opened a writable connection")
+            return real_connect(database, *args, **kwargs)
+
+        with patch.object(store, "connect", side_effect=AssertionError("writable store connection")), \
+                patch.object(store, "append_revision", side_effect=AssertionError("revision append")), \
+                patch.object(sqlite3, "connect", side_effect=readonly_connect):
+            summary = import_csv(self.csv, self.db, dry_run=True)
+        self.assertEqual(summary.updated, 1)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_existing_empty_sqlite_file_is_read_without_initializing_schema(self):
