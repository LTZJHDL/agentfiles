+    def test_incident_reports_match_current_records(self):
+        incident = Path(__file__).resolve().parents[1] / "examples" / "incident"
+        for filename, summary, expected in [
+            ("initial.csv", {"inserted": 4, "updated": 0, "unchanged": 0,
+                             "invalid": 0, "errors": []}, {
+                "count": 4, "total": 25, "groups": [
+                    {"day": "2026-01-10", "category": "rain", "count": 1, "total": 10},
+                    {"day": "2026-01-11", "category": "rain", "count": 1, "total": 7},
+                    {"day": "2026-01-12", "category": "snow", "count": 1, "total": 5},
+                    {"day": "2026-01-31", "category": "rain", "count": 1, "total": 3},
+                ],
+            }),
+            ("corrections.csv", {"inserted": 0, "updated": 2, "unchanged": 0,
+                                 "invalid": 0, "errors": []}, {
+                "count": 3, "total": 24, "groups": [
+                    {"day": "2026-01-10", "category": "rain", "count": 1, "total": 14},
+                    {"day": "2026-01-11", "category": "rain", "count": 1, "total": 7},
+                    {"day": "2026-01-31", "category": "rain", "count": 1, "total": 3},
+                ],
+            }),
+        ]:
+            result = self.cli("import", str(incident / filename), "--json")
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(json.loads(result.stdout), summary)
+            listing = self.cli("list", "--json")
+            self.assertEqual(listing.returncode, 0, listing.stderr)
+            january = [record for record in json.loads(listing.stdout)
+                       if "2026-01-01" <= record["day"] <= "2026-01-31"]
+            self.assertEqual(len(january), expected["count"])
+            self.assertEqual(sum(record["value"] for record in january), expected["total"])
+            with self.subTest(filename=filename):
+                result = self.cli("report", "--from", "2026-01-01",
+                                  "--to", "2026-01-31", "--json")
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(json.loads(result.stdout), expected)
